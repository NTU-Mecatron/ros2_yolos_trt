# Template: @TITLE@ and @DEBUG_TOPIC@ are substituted by scripts/record_demo.sh
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: "@TITLE@"
      Value: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: @DEBUG_TOPIC@
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Camera
      Value: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/image_raw
  Global Options:
    Background Color: 25; 25; 25
    Fixed Frame: camera_link
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
Window Geometry:
  Height: 720
  Width: 1280
  Displays:
    collapsed: false
